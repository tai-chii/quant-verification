# このリポジトリは kaggle/ と numerai/ のみを対象とする
*
!kaggle/
!kaggle/**
!numerai/
!numerai/**
!.gitignore
!README.md

# --- kaggle 内の除外（コンペデータ・他者の解法・バイナリキャッシュ） ---
kaggle/*/data/
kaggle/*/raw_solutions/
kaggle/*/submissions/
kaggle/*/notebooks/*.pkl

# --- numerai 内の除外（大容量データ・モデル重み・third-party公式リポジトリ） ---
numerai/cache/
numerai/uploads/
numerai/models/
numerai/data/
numerai/__pycache__/
numerai/example-scripts/
numerai/*.pkl
numerai/*.pt

# --- 生データ・運用ログ（コードの理解に不要なもの） ---
numerai/results/*_per_era.csv
numerai/results/*_per_era.partial.csv
numerai/results/*.partial.csv
numerai/results/*.parquet
numerai/results/*_log.txt
numerai/results/*_status.txt
kaggle/*/notebooks/*_log*.txt
