# リポジトリ全体の方針: コードと、それを理解するのに必要な最小限の情報（README・軽量な結果要約）のみを管理する。
# 生データのダンプ・中間生成物・運用ログはここで除外する（各検証/プロジェクト固有の除外は、それぞれのディレクトリの .gitignore も参照）。

.DS_Store
__pycache__/
*.pyc

# ブートストラップ等の生サンプル・運用ログ
financial-engineering/kensho-anomaly-decay/output/*_boot.csv
financial-engineering/kensho-anomaly-decay/output/*.log

# 採点実験のブラインド台帳・抜粋データ（結果の要約のみ残す）
financial-engineering/report-scoring/excerpts*.json
financial-engineering/report-scoring/labels.csv
financial-engineering/report-scoring/key_map.json
financial-engineering/report-scoring/scores_blind.json
# ma-cross-eurusd: バックテスト実行ごとのログ・中間結果（コードと要約以外は残さない方針）
financial-engineering/ma-cross-eurusd/run_*.log
financial-engineering/ma-cross-eurusd/results/
financial-engineering/ma-cross-eurusd/results_usdjpy/

# oshime-d1-yahoo-close-recheck: 元スクリプトの作業コピー（生データ CSV・取引明細を含む）と実行ログ。計画・要約・README のみ残す
financial-engineering/oshime-d1-yahoo-close-recheck/work_*/
financial-engineering/oshime-d1-yahoo-close-recheck/logs/
# 各検証の実行ログ・試走（smoke）結果
financial-engineering/*/results_run_*.log
financial-engineering/*/results/smoke_*

# /lab が書く自動コミットの予約（tools/mac_auto_push.sh が読む）
.lab_pending/
